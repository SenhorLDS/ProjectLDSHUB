function PrintConsole(Mensagem)
	pcall(function()
		task.spawn(function()
			game.CoreGui:WaitForChild("DevConsoleMaster").DevConsoleWindow.DescendantAdded:Connect(function(t)
				if t.Name == "msg" then
					t.RichText = true
				end
			end)
		end)

		local success = pcall(function()
			print("<font color='rgb(255,0,255)'>" .. Mensagem .. "</font>")
		end)

		if not success then
			print(Mensagem)
		end
	end)
end

